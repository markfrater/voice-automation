APP_NAME=NZ/AU Voice Partner Acquisition System
DATABASE_URL=sqlite:///./data/voice_partners.db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Apollo
APOLLO_API_KEY=

# Hunter
HUNTER_API_KEY=

# Optional LLM classification
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Crawler
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_PAGES=8
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_USER_AGENT=NZ-AU-Voice-Partner-Research/1.0

# Scoring
OUTREACH_SCORE_THRESHOLD=65
PRIORITY_SCORE_THRESHOLD=80
